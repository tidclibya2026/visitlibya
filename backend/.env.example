# Local development example only. Never commit populated environment files.
APP_ENV=development
DEBUG=false
DATABASE_URL=<local-database-url>
JWT_SECRET_KEY=<generate-a-local-secret-at-least-32-characters>
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
FORWARDED_ALLOW_IPS=127.0.0.1
LOG_LEVEL=INFO
